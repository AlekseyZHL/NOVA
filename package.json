{
  "name": "nova-wallet",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "NOVA Wallet — seedless multichain custodial wallet as a Telegram Mini App (testnet MVP)",
  "author": "NOVA Wallet contributors",
  "license": "MIT",
  "homepage": "https://github.com/AlekseyZHL/NOVA#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlekseyZHL/NOVA.git"
  },
  "bugs": {
    "url": "https://github.com/AlekseyZHL/NOVA/issues"
  },
  "keywords": [
    "telegram-mini-app",
    "cryptocurrency-wallet",
    "multichain",
    "bip39",
    "slip-0010",
    "ethereum",
    "bitcoin",
    "solana",
    "testnet"
  ],
  "scripts": {
    "start": "node server/index.js",
    "setup": "node scripts/setup.js",
    "test": "node tests/smoke.js",
    "test:ui": "node tests/ui.js",
    "test:entry": "node tests/telegram-entry.js",
    "test:all": "npm test && npm run test:ui && npm run test:entry",
    "secrets": "bash scripts/check-secrets.sh",
    "check:syntax": "node scripts/check-syntax.js",
    "release": "python3 scripts/build_release.py"
  },
  "dependencies": {
    "@solana/web3.js": "1.95.3",
    "bip32": "4.0.0",
    "bip39": "3.1.0",
    "bitcoinjs-lib": "6.1.5",
    "bs58": "5.0.0",
    "dotenv": "16.4.5",
    "ecpair": "2.1.0",
    "ed25519-hd-key": "1.3.0",
    "ethers": "6.13.4",
    "express": "4.21.1",
    "qrcode": "1.5.4",
    "tiny-secp256k1": "2.2.3"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
