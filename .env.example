# ============================================================
# NOVA Wallet — конфигурация (без секретов, можно коммитить)
# Копию с реальными ключами создаёт `npm run setup`
# ============================================================

PORT=3000

# Главный предохранитель. true = РЕАЛЬНЫЕ СРЕДСТВА.
ALLOW_MAINNET=false

# Гостевой вход для браузерного превью. В mainnet автоматически выключен.
DEMO_AUTH=true

# Токен от @BotFather. Без него бот не запускается, но Mini App доступен в браузере.
BOT_TOKEN=

# Публичный HTTPS-URL Mini App (нужен для кнопки web_app в боте).
# Если не задан, в Arena подставляется https://<PORT>-<E2B_SANDBOX_ID>.e2b.app
WEBAPP_URL=

# Лимиты по умолчанию (пользователь может менять в интерфейсе, но не выше своего лимита)
PER_TX_LIMIT_USD=250
DAILY_LIMIT_USD=1000
INITDATA_MAX_AGE=86400

# ---------------- Переопределения RPC (опционально) ----------
# SEPOLIA_RPC=
# BASE_SEPOLIA_RPC=
# ARB_SEPOLIA_RPC=
# AMOY_RPC=
# SOLANA_DEVNET_RPC=
# ETH_RPC=
# BASE_RPC=
# ARB_RPC=
# POLYGON_RPC=
# SOLANA_RPC=

# ---------------- Секреты (генерирует setup.js) --------------
# VAULT_KEY=<64 hex chars>       32-byte AES-256-GCM key
# SESSION_SECRET=<64 hex chars>  HMAC key for session + confirm tokens
# MASTER_MNEMONIC=<24 words>    импорт существующего seed (иначе генерируется)
